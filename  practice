CREATE PROCEDURE SP_BANKTRANS(
 
 @AC BIGINT,
 @PIN INT,
 @TYPE VARCHAR(20),
 @TAMT INT 
 ) AS
BEGIN

 IF (SELECT COUNT(*) FROM AC WHERE AC_NO = @AC) = 0 
   BEGIN 
   PRINT 'AC NUMBER DOES NOT EXIST, PLEASE CHECK AND INPUT CORRECT AC NO !!!!'
   RETURN 
   END 
 ELSE IF (SELECT COUNT(*) FROM AC WHERE AC_NO = @AC AND ATM_PIN = @PIN ) = 0 
 BEGIN 
 PRINT 'PIN IS INCORRECT , PLEASE CHECK AND INPUT CORRECT PIN !!!!'
 RETURN 
 END 
 ELSE IF @TYPE = 'DEBIT' AND (SELECT BALANCE FROM AC WHERE AC_NO = @AC ) < @TAMT
 BEGIN 
 PRINT ' INSUFFICIENT BALANCE IN AC, PLEASE CHECK '
 END
ELSE 
BEGIN
    IF @TYPE = ' DEBIT'
    BEGIN 
         UPDATE AC SET BALANCE = BALANCE - @TAMT WHERE AC_NO = @AC
    END 

    IF @TYPE = ' CREDIT '
    BEGIN 
         UPDATE AC SET BALANCE = BALANCE + @TAMT WHERE AC_NO = @AC
    END

DECLARE @CNAME VARCHAR(100)
DECLARE @TDATE DATETIME
DECLARE @TID VARCHAR(100)
DECLARE @FINALBALANCE INT 

SET @CNAME = (SELECT C.C_NAME FROM CUST  AS C INNER JOIN AC AS A ON C.C_ID = A.C_ID WHERE A.AC_NO = @AC )
SET @TDATE = GETDATE()
SET @TID = (CONCAT(UPPER(LEFT(@CNAME ,2)), LEFT(@AC,1), RIGHT(@AC,1), YEAR(@TDATE), MONTH(@TDATE), DATEPART(HH, @TDATE),
 DATEPART(MI, @TDATE), DATEPART(SS, @TDATE), DATEPART(MILLISECOND, @TDATE)))
SET @FINALBALANCE = (SELECT BALANCE FROM AC WHERE AC_NO = @AC)

INSERT INTO TRANS VALUES(@CNAME, @AC, @TDATE, @TID, @TYPE, @TAMT, @FINALBALANCE )

PRINT ' TRANSCTION SUCCESSFUL'
END
END



