--Write a query to identify customers whose total spending exceeds the overall average customer spending.
WITH AVGSPEEDING AS (
SELECT C.Name, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS TOTAL_SPEEDING  

FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.[CustomerKey], C.Name
)
SELECT Name, TOTAL_SPEEDING 
FROM AVGSPEEDING 
WHERE  TOTAL_SPEEDING  > (
 SELECT AVG(TOTAL_SPEEDING)
 FROM AVGSPEEDING
)
ORDER BY TOTAL_SPEEDING DESC

--Write a query to rank all stores based on their total revenue.
SELECT S.[StoreKey], C.Country, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE,
DENSE_RANK()OVER(ORDER BY SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) DESC
) AS STORE_RANK
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY S.[StoreKey], C.Country
ORDER BY STORE_RANK, REVENUE DESC

--Write a query to calculate each customer's percentage contribution to total company revenue.
WITH CUSTOMERPERCENTAGE AS (
SELECT C.Name,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Name
)
SELECT Name, REVENUE,
CAST(REVENUE/NULLIF(SUM(REVENUE)OVER(), 0 )* 100 AS DECIMAL(10,2)) AS contribution_Per
FROM CUSTOMERPERCENTAGE
ORDER BY REVENUE DESC 

--The Operations Manager wants to identify which stores consistently deliver orders the fastest. 
--Write a query to display store key, country, state, total orders, and average delivery days, 
--sorted by the fastest delivery time.
SELECT S.[StoreKey], C.Country, C.State, 
COUNT(S.[Order Date]) AS TOTAL_ORDER,
AVG(DATEDIFF(DD, CONVERT(DATE, [Order Date], 105) , 
CONVERT(DATE, [Delivery Date], 105) )) AS AVGDAYS
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
GROUP BY  S.[StoreKey], C.Country, C.State
ORDER BY TOTAL_ORDER DESC 

--Management wants to investigate stores with poor delivery performance. Write a query to display 
--the top 5 stores with the highest average delivery days.
SELECT  TOP 5 S.[StoreKey], C.Country, C.State, 
COUNT(S.[Order Date]) AS TOTAL_ORDER,
AVG(DATEDIFF(DD, CONVERT(DATE, [Order Date], 105) , 
CONVERT(DATE, [Delivery Date], 105) )) AS AVGDAYS
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
GROUP BY  S.[StoreKey], C.Country, C.State
ORDER BY AVGDAYS DESC 

--Finance wants to know which product categories generate the highest profit margin. Write a query to display 
--category, revenue, cost, profit, and profit percentage, sorted by profit percentage in descending order.
SELECT P.Category, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS COST,
(SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) -
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',', '') AS DECIMAL(10,2)))) AS PROFIT 
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.Category
ORDER BY PROFIT  DESC

WITH CUST AS (
SELECT P.Category, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS COST
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.Category
)
SELECT Category, REVENUE , COST,
CAST(REVENUE - COST AS DECIMAL(10,2)) AS PROFIT,
CAST((REVENUE - COST)/ NULLIF(REVENUE, 0 )* 100 AS DECIMAL(10,2)) AS PROFIT_PERC
FROM CUST 
ORDER BY PROFIT DESC

--Marketing wants to know which brands dominate each country. Write a query to display 
--the top 5 brands (by revenue) within each country, along with their rank.
WITH TOPBRAND AS (
SELECT  C.Country, P.Brand, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE,
DENSE_RANK()OVER(PARTITION BY C.Country 
ORDER BY SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2)))  ) AS RANK 
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Country, P.Brand
)
SELECT Country, Brand, REVENUE, RANK 
FROM TOPBRAND 
WHERE RANK <= 5 
ORDER BY  Country, RANK 

--The CFO wants to track cumulative revenue throughout the year. Write a query to display year, month, 
--monthly revenue, and running (cumulative) revenue.
WITH CFO AS (
SELECT YEAR(CONVERT(DATE, S.[Order Date], 105)) AS SALESYEAR,
MONTH(CONVERT(DATE, S.[Order Date], 105)) AS SALESMONTH,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '')AS DECIMAL(10,2))) AS REVENUE
FROM Sales  AS S 
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY YEAR(CONVERT(DATE, S.[Order Date], 105)) ,
MONTH(CONVERT(DATE, S.[Order Date], 105)) 
)
SELECT SALESYEAR, SALESMONTH, REVENUE,
SUM(REVENUE)OVER(PARTITION BY SALESYEAR ORDER BY SALESMONTH ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS RUNNING_REVENUE
FROM CFO 
ORDER BY SALESYEAR, SALESMONTH

--Management wants to compare each month's revenue with the previous month. Write a query to display year,
-- month, current month revenue, previous month revenue, and month-over-month growth.
WITH MANAGEMENT AS (
SELECT YEAR(CONVERT(DATE, S.[Order Date], 105 )) AS SALESYEAR,
MONTH(CONVERT(DATE, S.[Order Date], 105)) AS SALESMONTH,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '')AS DECIMAL(10,2))) AS REVENUE
FROM Sales  AS S 
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY YEAR(CONVERT(DATE, S.[Order Date], 105 )) ,
MONTH(CONVERT(DATE, S.[Order Date], 105)) 
)
SELECT SALESYEAR, SALESMONTH, REVENUE,
LAG(REVENUE)OVER(ORDER BY SALESYEAR, SALESMONTH) AS PRV_SALES,
CAST(
   (REVENUE - LAG(REVENUE)OVER(ORDER BY SALESYEAR, SALESMONTH))/
   NULLIF(LAG(REVENUE)OVER(ORDER BY SALESYEAR, SALESMONTH), 0) * 100  AS DECIMAL(10,2)
) AS MOM_GROWTH_PERC
FROM MANAGEMENT 
ORDER BY SALESYEAR, SALESMONTH

--Write a query to find the highest-selling product color (by quantity) within each product category.
WITH HIGHESTSELLINGPRODUCTCOLOUR AS (
SELECT P.Category, P.Color, 
SUM(S.Quantity) AS QTY
FROM Sales  AS S 
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.Category, P.Color
)
SELECT Category, Color, QTY, 
RN
FROM ( SELECT Category, Color, QTY, 
ROW_NUMBER()OVER(PARTITION BY Category ORDER BY QTY) AS RN 
FROM HIGHESTSELLINGPRODUCTCOLOUR 
) AS X
WHERE RN = 1
ORDER BY Category

--Write a query to identify customers who have made purchases in more than one store country 
--(e.g., customers who travel and shop internationally).
SELECT C.Name, 
COUNT(DISTINCT R.Country) AS NO_OF_STORE
FROM Cust_join AS C 
INNER JOIN Sales AS S 
ON C.[CustomerKey] = S.[CustomerKey]
INNER JOIN Stores AS R 
ON S.StoreKey = R.StoreKey
GROUP BY C.Name
HAVING COUNT(DISTINCT R.Country) > 1
ORDER BY NO_OF_STORE DESC

--Marketing wants age-wise revenue insights. Write a query to calculate total revenue by customer 
--age group (18-25, 26-35, 36-45, 46-60, 60+) at the time of purchase.
WITH CUSTOMERAGE AS 
(
SELECT
S.Quantity *
CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '')AS DECIMAL(10,2)) AS REVENUE,

DATEDIFF(YEAR,
CONVERT(DATE, C.Birthday, 105),
CONVERT(DATE, S.[Order Date], 105)
)
-
 CASE
WHEN DATEADD(YEAR,DATEDIFF(YEAR,
CONVERT(DATE, C.Birthday, 105),
CONVERT(DATE, S.[Order Date], 105)
),
CONVERT(DATE, C.Birthday, 105)
) > CONVERT(DATE, S.[Order Date], 105)
THEN 1
ELSE 0
END AS AGE

FROM Sales AS S
INNER JOIN Cust_Join AS C
ON S.CustomerKey = C.CustomerKey
INNER JOIN Products AS P
ON S.ProductKey = P.ProductKey
)

SELECT
CASE
WHEN AGE BETWEEN 18 AND 25 THEN '18-25'
WHEN AGE BETWEEN 26 AND 35 THEN '26-35'
WHEN AGE BETWEEN 36 AND 45 THEN '36-45'
WHEN AGE BETWEEN 46 AND 60 THEN '46-60'
WHEN AGE >= 61 THEN '60+'
END AS AGE_GROUP,

SUM(REVENUE) AS TOTAL_REVENUE

FROM CUSTOMERAGE

WHERE AGE >= 18

GROUP BY
CASE
WHEN AGE BETWEEN 18 AND 25 THEN '18-25'
WHEN AGE BETWEEN 26 AND 35 THEN '26-35'
WHEN AGE BETWEEN 36 AND 45 THEN '36-45'
WHEN AGE BETWEEN 46 AND 60 THEN '46-60'
WHEN AGE >= 61 THEN '60+'
END
ORDER BY AGE_GROUP

--The CEO requires a single query to power an executive dashboard. Write a query to return total revenue (USD), 
--total cost (USD), total profit (USD), profit percentage, total orders, total customers, total products sold, 
--average order value, and total revenue in local currency.
WITH SALESDATA AS (
SELECT
S.[Order Number], S.CustomerKey, S.Quantity,
S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '')AS DECIMAL(18,2)) AS REVENUEUSD,
S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',', '')AS DECIMAL(18,2)) AS COSTUSD,
S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '')AS DECIMAL(18,2)) * E.Exchange AS REVENUELOCAL
FROM Sales  AS S 
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
INNER JOIN Exchange_Rates AS E 
ON E.[Currency] = S.[Currency Code] AND E.[Date] =  S.[Order Date]
) 
SELECT 
CAST(SUM(REVENUEUSD) AS DECIMAL(18,2)) AS TOTAL_REVENUE,
CAST(SUM(COSTUSD) AS DECIMAL(18,2)) AS TOTAL_COST,
CAST(SUM(REVENUEUSD)- SUM(COSTUSD) AS DECIMAL(18,2)) AS PROFIT,
CAST((SUM(REVENUEUSD) - SUM(COSTUSD))/ NULLIF(SUM(REVENUEUSD), 0) * 100 AS DECIMAL(18,2)) AS PROFIT_PERC,
COUNT(DISTINCT [Order Number]) AS TOTAL_ORDERS,
COUNT(DISTINCT [CustomerKey]) AS TOTAL_CUSTOMER,
SUM(Quantity) AS TOTAL_PRODUCT_SOLD,
CAST(SUM(REVENUEUSD)/ NULLIF(COUNT(DISTINCT [Order Number]), 0) AS DECIMAL(18,2)) AS AVG_ORDER_VALUE,
CAST(SUM(REVENUELOCAL) AS DECIMAL(18,2)) AS TOTAL_REVENUE_LOC
FROM SALESDATA 
