 
--Write a query to display every sales order along with the corresponding customer name, product name, 
--and quantity purchased.
SELECT S.[Order Number], C.NAME, P.[Product Name] AS Product_Name , S.QUANTITY
FROM Sales AS S
INNER JOIN  CUST_JOIN  AS C 
ON S.CustomerKey = C.CustomerKey
INNER JOIN Products AS P
ON S.ProductKey = P.ProductKey
ORDER BY Quantity DESC

--Write a query to display, for every sale, the customer name, customer country, product name, 
--product category, and quantity sold.
SELECT C.NAME,  C.COUNTRY,  P.[Product Name],  P.CATEGORY,  S.QUANTITY FROM SALES AS S
INNER JOIN  CUST_JOIN  AS C 
ON S.CustomerKey = C.CustomerKey
INNER JOIN Products AS P
ON S.ProductKey = P.ProductKey
ORDER BY Quantity DESC 

--Write a query to calculate the total quantity sold for each combination of store country and product category.
SELECT C.COUNTRY, P.CATEGORY, SUM(S.Quantity) AS TOTAL_QTY FROM Sales AS S
INNER JOIN  CUST_JOIN   AS C 
ON S.CustomerKey = C.CustomerKey
INNER JOIN Products AS P
ON S.ProductKey = P.ProductKey
GROUP BY C.COUNTRY, P.CATEGORY

---Write a query to calculate the total sales revenue (in USD) generated across all orders.
SELECT SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
) AS  TOTAL_SALES_REVENUE_USD FROM Sales AS S
INNER JOIN Products AS P  
ON S.ProductKey = P.ProductKey 

--Write a query to calculate total sales converted into each order's local currency, using the exchange rate matched 
--by currency code and order date.
SELECT S.[Order Number], S.[Currency Code], SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')
AS DECIMAL(10,2 )) * E.Exchange
) AS  TOTAL_LOCAL_SALES FROM Sales AS S
INNER JOIN Products AS P  
ON S.ProductKey = P.ProductKey 
INNER JOIN Exchange_Rates AS E
ON S.[Order Date] = E.Date AND 
S.[Currency Code] = E.Currency
GROUP BY S.[Order Number],
 S.[Currency Code]

--Write a query to display, for each order, the total sales in both USD and the local currency side by side.
SELECT S.[Order Number], SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '') 
AS DECIMAL(10,2))) AS SALES_USD , SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '') 
AS DECIMAL(10, 2)) * E.Exchange) AS LOCAL_SALES FROM Sales AS S
INNER JOIN Products AS P  
ON S.ProductKey = P.ProductKey 
INNER JOIN Exchange_Rates AS E
ON S.[Order Date] = E.Date AND 
S.[Currency Code] = E.Currency
GROUP BY S.[Order Number]

--Assume the Sales table stores the order amount in local currency. Write a query to convert this local currency amount 
--into USD for each order using the applicable exchange rate.
SELECT S.[Order Number], SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '') AS DECIMAL(10,2)) * E.Exchange) 
AS USD_AMOUNT FROM Sales AS S
INNER JOIN Products AS P
ON S.ProductKey = P.ProductKey 
INNER JOIN Exchange_Rates AS E
ON S.[Order Date] = E.Date AND 
S.[Currency Code] = E.Currency
GROUP BY S.[Order Number]

--Write a query to identify the top 10 customers ranked by total sales revenue.
SELECT TOP 10 C.Name, SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
) AS  TOTAL_SALES,
DENSE_RANK()OVER(ORDER BY SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
) DESC ) AS D_RNK  FROM Sales AS S
INNER JOIN Cust_join AS C 
ON C.[CustomerKey] = S.[CustomerKey]
INNER JOIN Products AS P
ON P.[ProductKey] = S.[ProductKey]
GROUP BY C.Name

--Write a query to find the best-selling product (by revenue) within each product category.

WITH Productrevenue AS (
SELECT P.Category, P.[Product Name], 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
) AS  TOTAL_SALES FROM Products AS P  
INNER JOIN Sales AS S
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.Category, P.[Product Name] 
)
SELECT Category, [Product Name], 
TOTAL_SALES FROM (
    SELECT *, ROW_NUMBER()OVER(PARTITION BY Category ORDER BY TOTAL_SALES DESC) AS RN
 FROM Productrevenue 
) AS X 
WHERE RN = 1 

--Write a query to calculate the number of days taken to deliver each order, along with the customer name.
SELECT S.[Order Number], DATEDIFF(DD, CONVERT(DATE, [Order Date], 105) , 
CONVERT(DATE, [Delivery Date], 105) ) AS NO_OF_DAYS , C.Name FROM Sales AS S
INNER JOIN Cust_join AS C
ON S.[CustomerKey] = C.[CustomerKey]

--Write a query to calculate the average order delivery time (in days) for each customer country.
SELECT C.Country, AVG(DATEDIFF(DD, CONVERT(DATE, [Order Date], 105) , 
CONVERT(DATE, [Delivery Date], 105) )) AS AVGDAYS FROM Sales AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
GROUP BY C.Country

--Write a query to identify the top 5 product brands ranked by total revenue.
SELECT TOP 5 P.Brand, SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
 ) AS REVENUE  
  FROM Products  AS P
 INNER JOIN Sales AS S
 ON P.[ProductKey] = S.[ProductKey]
GROUP BY P.Brand 
ORDER BY REVENUE DESC

--Write a query to identify the single store that has generated the highest total revenue.
SELECT  TOP 1 S.StoreKey, SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
 ) AS REVENUE FROM Sales AS S
 INNER JOIN Products AS P
 ON S.[ProductKey] = P.[ProductKey]
 GROUP BY S.StoreKey
 ORDER BY REVENUE DESC 

 WITH STOREREVENUE AS (
    SELECT  TOP 1 S.StoreKey, SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
 ) AS REVENUE FROM Sales AS S
 INNER JOIN Products AS P
 ON S.[ProductKey] = P.[ProductKey]
 GROUP BY S.StoreKey
 ORDER BY REVENUE DESC 
 ) 

 SELECT StoreKey, REVENUE 
 FROM (
    SELECT *, DENSE_RANK()OVER(ORDER BY REVENUE) AS STORE_RNK
    FROM STOREREVENUE
 ) AS X 
 WHERE STORE_RNK = 1

--Write a query to calculate the total profit generated by each product category.
SELECT P.Category, SUM(S.Quantity * (CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
 -(CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))) )) AS PROFIT 
FROM Products AS P
INNER JOIN Sales AS S  
ON P.[ProductKey] = S.[ProductKey]
GROUP BY P.Category 
ORDER BY PROFIT DESC

--Write a query to calculate the total profit generated by customers in each country.
SELECT C.Country, SUM(S.Quantity * (CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
 -(CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))) )) AS PROFIT 
 FROM Sales AS S
 INNER JOIN Cust_join AS C
 ON S.[CustomerKey] = C.[CustomerKey]
 INNER JOIN Products AS P
 ON S.[ProductKey] = P.[ProductKey]
 GROUP BY C.Country
 ORDER BY PROFIT DESC

--Write a query to identify the top 3 best-selling products (by revenue) within each product category, using a ranking 
--window function such as ROW_NUMBER(), RANK(), or DENSE_RANK().
WITH Productrevenue AS (
SELECT P.Category, P.[Product Name], 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
) AS  TOTAL_SALES FROM Products AS P  
INNER JOIN Sales AS S
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.Category, P.[Product Name] 
)
SELECT  Category, [Product Name], 
TOTAL_SALES FROM (
    SELECT *, ROW_NUMBER()OVER(PARTITION BY Category ORDER BY TOTAL_SALES DESC) AS RN
 FROM Productrevenue 
) AS X 
WHERE  RN <= 3
ORDER BY Category , RN

--Write a query to calculate each customer's age at the time they placed each order.
SELECT C.Name, DATEDIFF(YYYY, CONVERT(DATE, C.Birthday, 105), CONVERT(DATE, S.[Order Date], 105) ) AS AGE 
FROM Cust_join AS C
INNER JOIN Sales AS S
ON C.[CustomerKey] = S.[CustomerKey]

--Write a query to identify customers who have made purchases from more than one store.
SELECT C.Name, COUNT(DISTINCT S.StoreKey) AS STOREVISIT 
FROM Sales AS S
INNER JOIN Cust_join AS C
ON C.[CustomerKey] = S.[CustomerKey]
GROUP BY C.Name
HAVING COUNT(DISTINCT S.StoreKey) > 1

--Write a query to calculate total revenue generated by each store, grouped by store country and state.
SELECT C.Country , C.State , SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
) AS REVENUE FROM Cust_join AS C 
INNER JOIN Sales AS S
ON  C.[CustomerKey] = S.[CustomerKey]
INNER JOIN Products AS P
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Country ,  C.State
ORDER BY REVENUE DESC

--Write a query to calculate total revenue generated on each continent.
SELECT C.Continent , SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2 ))
) AS REVENUE FROM Cust_join AS C 
INNER JOIN Sales AS S
ON  C.[CustomerKey] = S.[CustomerKey]
INNER JOIN Products AS P
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Continent

--Write a query to identify repeat customers, i.e., customers who have placed more than one order.
SELECT C.Name, COUNT(S.[Order Date]) AS NO_OF_ORDERS 
FROM Sales AS S 
INNER JOIN Cust_join AS C
ON C.[CustomerKey] = S.[CustomerKey]
GROUP BY C.Name
HAVING COUNT(S.[Order Date]) > 1
ORDER BY NO_OF_ORDERS  DESC

--Write a query to identify customers who have purchased products from more than one product category.
SELECT C.Name, COUNT( DISTINCT P.Category ) AS CategoriesPurchased 
FROM Cust_join AS C
INNER JOIN Sales AS S
ON C.[CustomerKey] = S.[CustomerKey]
INNER JOIN Products AS P
ON S.[ProductKey] = P.[ProductKey] 
GROUP BY C.Name 
HAVING COUNT( DISTINCT P.Category ) > 1
ORDER BY CategoriesPurchased DESC

