--Write a query to calculate revenue, cost, profit, profit percentage, and revenue in local currency for each country.
WITH SALES_DATA AS (

SELECT C.Country,

SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '') AS DECIMAL(10,2))) AS REVENUE,

SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',' , '') AS DECIMAL(10,2))) AS COST, 

SUM(S.Quantity * 
CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',' , '')AS DECIMAL(10,2))
- (CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',','')AS DECIMAL(10,2)))) AS PROFIT, 
 
SUM(S.Quantity * (CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '')AS DECIMAL(10,2))) * E.Exchange) AS LOC_REVENUE
FROM Sales AS S
INNER JOIN Cust_join AS C
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P
ON P.[ProductKey] = S.[ProductKey]
INNER JOIN Exchange_Rates AS E
ON S.[Order Date] = E.Date AND 
S.[Currency Code] = E.Currency
GROUP BY C.Country
)
SELECT Country , REVENUE, COST, PROFIT, 
CAST(PROFIT/ NULLIF(REVENUE,0)*100 AS DECIMAL(10,2)) AS PROFIT_PREC, 
LOC_REVENUE
FROM SALES_DATA 

ORDER BY REVENUE DESC

--The marketing team wants to identify high-value customers for a loyalty program. 
--Write a query to display each customer's name, country, total number of orders, 
--total quantity purchased, and total sales in USD, sorted by highest sales.

SELECT C.Name, C.Country, 
COUNT( DISTINCT S.[Order Date])AS NO_OF_ORDERS,
SUM(S.Quantity) AS TOTAL_QUANTITY,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS TOTAL_SALE_USD
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Name, C.Country
ORDER BY TOTAL_SALE_USD DESC

--The procurement department wants to identify products with the highest profit contribution. 
--Write a query to display product name, brand, revenue, cost, and profit, sorted by profit in descending order.
SELECT P.[Product Name], P.Brand, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS COST,
(SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2)))  -
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',', '') AS DECIMAL(10,2))) ) AS PROFIT 
FROM Sales  AS S 
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.[Product Name], P.Brand 
ORDER BY PROFIT DESC 

WITH procurement AS (
   SELECT P.[Product Name], P.Brand, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Cost USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS COST
FROM Sales  AS S 
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.[Product Name], P.Brand 
)
SELECT [Product Name], Brand, REVENUE, COST, 
CAST(REVENUE - COST AS DECIMAL(10,2)) AS PROFIT 
FROM procurement 
ORDER BY PROFIT DESC  

--Management wants to know which stores are generating the highest sales. Write a query to display 
--total revenue for every store along with store country, state, and store size (square meters).
SELECT C.Country, C.State, R.[Square Meters],
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
INNER JOIN Stores AS R 
ON S.[StoreKey] = R.[StoreKey]
GROUP BY C.Country, C.State, R.[Square Meters]
ORDER BY REVENUE DESC 

--The CEO wants to identify the best-selling product category in each country. 
--Write a query to display the top-selling category (by revenue) for every customer country.
SELECT C.Country, P.Category, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Country, P.Category
ORDER BY REVENUE DESC 

--Finance wants to calculate revenue in each customer's local currency. Write a query to display order number, 
--customer name, currency code, revenue in USD, and revenue in local currency.
SELECT S.[Order Number], C.Name, S.[Currency Code], 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2)) * E.Exchange) AS LOCAL_REVENUE
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
INNER JOIN Exchange_Rates AS E 
ON E.[Currency] = S.[Currency Code] AND E.[Date] =  S.[Order Date]
GROUP BY S.[Order Number], C.Name, S.[Currency Code]
ORDER BY REVENUE DESC , LOCAL_REVENUE DESC 

--Write a query to find customers who have purchased products from at least three different brands.
SELECT C.Name, COUNT(DISTINCT P.Brand) AS purchased_Brand
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Name 
HAVING COUNT(DISTINCT P.Brand) >= 3
ORDER BY purchased_Brand DESC

--Write a query to calculate the average order value for each country.
WITH AOV AS (
SELECT C.Country , 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS ORDER_VALUE 
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY C.Country 
)
SELECT Country , AVG(ORDER_VALUE ) AS AVG_ORDER_VALUE 
FROM AOV 
GROUP BY Country
ORDER BY AVG_ORDER_VALUE  DESC

--Write a query to find the oldest customer (by birthday) who has placed at least one order.
SELECT TOP 1 C.Name, C.Country, C.Birthday 
FROM Cust_join AS C 
WHERE EXISTS (
SELECT 1
FROM Sales AS S 
WHERE S.CustomerKey = C.CustomerKey

)
ORDER BY CONVERT(DATE, C.Birthday, 105) 

WITH BRITHDAY AS (
   SELECT MIN(CONVERT(DATE, C.Birthday, 105)) AS OLD_BDAY
   FROM Cust_Join AS C
   INNER JOIN Sales AS S
ON C.CustomerKey = S.CustomerKey
)
SELECT DISTINCT 
C.Name, C.Country, C.Birthday
FROM Cust_Join AS C
   INNER JOIN Sales AS S
ON C.CustomerKey = S.CustomerKey
CROSS JOIN BRITHDAY AS B 
WHERE CONVERT(DATE, C.Birthday, 105) = B.OLD_BDAY 

--Write a query to display yearly revenue for each product category.
SELECT YEAR(CONVERT(DATE, S.[Order Date], 105)) AS SALESYEAR , P.Category, 
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE 
FROM Sales  AS S 
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY YEAR(CONVERT(DATE, S.[Order Date], 105)), P.Category 
ORDER BY  SALESYEAR ,REVENUE DESC

--Write a query to identify products that have never been sold.
SELECT P.[ProductKey], P.[Product Name]
FROM Products AS P 
LEFT JOIN Sales AS S 
ON P.[ProductKey] = S.[ProductKey]
WHERE S.[ProductKey] IS NULL

--Write a query to identify stores that have never processed an order.
SELECT R.[StoreKey] , R.Country, R.State
FROM Stores AS R 
LEFT JOIN Sales AS S
ON R.[StoreKey] = S.[StoreKey]
WHERE S.[StoreKey] IS NULL

--Write a query to display monthly revenue for each product brand.
SELECT 
YEAR(CONVERT(DATE, S.[Order Date], 105 )) AS YEARSALE,
MONTH(CONVERT(DATE, S.[Order Date], 105 )) AS MONTHSALE,
P.Brand,
SUM(S.Quantity * CAST(REPLACE(REPLACE(P.[Unit Price USD], '$', ''), ',', '') AS DECIMAL(10,2))) AS REVENUE 
FROM Sales  AS S 
INNER JOIN Cust_join AS C 
ON S.[CustomerKey] = C.[CustomerKey]
INNER JOIN Products AS P 
ON S.[ProductKey] = P.[ProductKey]
GROUP BY P.Brand, YEAR(CONVERT(DATE, S.[Order Date], 105 )) ,MONTH(CONVERT(DATE, S.[Order Date], 105 ))
